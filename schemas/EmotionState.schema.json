      "title": "Primary",
      "type": "string"
    },
    "secondary": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Secondary"
    },
    "families": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_.-]*$",
        "type": "string"
      },
      "title": "Families",
      "type": "array",
      "uniqueItems": true
    },
    "intensity": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Intensity",
      "type": "number"
    },
    "vad": {
      "$ref": "#/$defs/VAD"
    },
    "restraint": {
      "default": 0.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Restraint",
      "type": "number"
    },
    "awareness": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Awareness",
      "type": "number"
    },
    "duration_ms": {
      "default": 0,
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "decay_half_life_ms": {
      "exclusiveMinimum": 0,
      "title": "Decay Half Life Ms",
      "type": "integer"
    },
    "trigger_refs": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_.-]*$",
        "type": "string"
      },
      "title": "Trigger Refs",
      "type": "array"
    },
    "appraisal": {
      "$ref": "#/$defs/Appraisal",
      "default": {
        "goal_congruence": 0.0,
        "controllability": 0.5,
        "responsibility": "unknown",
        "certainty": 0.5
      }
    }

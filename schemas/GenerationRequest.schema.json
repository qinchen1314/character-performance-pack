            "unknown"
          ],
          "title": "Responsibility",
          "type": "string"
        },
        "certainty": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Certainty",
          "type": "number"
        }
      },
      "title": "Appraisal",
      "type": "object"
    },
    "ArcState": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "openness_delta": {
          "default": 0.0,

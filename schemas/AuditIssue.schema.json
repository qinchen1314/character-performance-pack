{
  "$defs": {
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "SourceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "issue_id": {
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Issue Id",
      "type": "string"
    },
    "severity": {
      "enum": [
        "block",
        "rewrite",
        "warning"
      ],
      "title": "Severity",
      "type": "string"
    },
    "code": {
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Code",
      "type": "string"
    },
    "spans": {
      "items": {
        "$ref": "#/$defs/SourceSpan"
      },
      "title": "Spans",
      "type": "array"
    },
    "actor_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actor Id"
    },
    "evidence": {
      "additionalProperties": true,
      "title": "Evidence",
      "type": "object"
    },
    "preserve": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_.-]*$",
        "type": "string"
      },
      "title": "Preserve",
      "type": "array",
      "uniqueItems": true
    },
    "alternatives": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_.-]*$",
        "type": "string"
      },
      "title": "Alternatives",
      "type": "array"
    }
  },
  "required": [
    "issue_id",
    "severity",
    "code",
    "spans"
  ],
  "title": "AuditIssue",
  "type": "object"
}

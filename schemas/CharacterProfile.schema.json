      "title": "Id",
      "type": "string"
    },
    "personality": {
      "$ref": "#/$defs/Personality",
      "default": {
        "big_five": {
          "agreeableness": 0.5,
          "conscientiousness": 0.5,
          "extraversion": 0.5,
          "neuroticism": 0.5,
          "openness": 0.5
        }
      }
    },
    "expression_baseline": {
      "$ref": "#/$defs/ExpressionBaseline",
      "default": {
        "amplitude": 0.5,
        "initiative": 0.5,
        "speech_volume": 0.5,
        "gaze_duration": 0.5
      }
    },
    "capabilities": {

{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "strategy_id": {
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Strategy Id",
      "type": "string"
    },
    "intent": {
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Intent",
      "type": "string"
    },
    "surface_goal": {
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Surface Goal",
      "type": "string"
    },
    "private_goal": {
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Private Goal",
      "type": "string"
    },
    "applicability_conditions": {
      "items": {
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_.-]*$",
        "type": "string"
      },
      "title": "Applicability Conditions",
      "type": "array",
      "uniqueItems": true
    },
    "contraindications": {
      "items": {
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_.-]*$",
        "type": "string"
      },
      "title": "Contraindications",
      "type": "array",
      "uniqueItems": true
    },
    "preferred_channels": {
      "items": {
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_.-]*$",
        "type": "string"
      },
      "title": "Preferred Channels",
      "type": "array"
    },
    "suppressed_channels": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_.-]*$",
        "type": "string"
      },
      "title": "Suppressed Channels",
      "type": "array",
      "uniqueItems": true
    },
    "allowed_visibility": {
      "enum": [
        "hidden",
        "very_subtle",
        "subtle",
        "noticeable",
        "obvious",
        "unknown"
      ],
      "title": "Allowed Visibility",
      "type": "string"
    },
    "action_budget": {
      "maximum": 6,
      "minimum": 0,
      "title": "Action Budget",
      "type": "integer"
    },
    "omit_action_allowed": {
      "title": "Omit Action Allowed",
      "type": "boolean"
    },
    "relationship_meaning": {
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Relationship Meaning",
      "type": "string"
    },
    "reasons": {
      "items": {
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_.-]*$",
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "secondary_strategy_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Secondary Strategy Id"
    }
  },
  "required": [
    "strategy_id",
    "intent",
    "surface_goal",
    "private_goal",
    "applicability_conditions",
    "contraindications",
    "preferred_channels",
    "allowed_visibility",
    "action_budget",
    "omit_action_allowed",
    "relationship_meaning",
    "reasons"
  ],
  "title": "ReactionStrategyPlan",
  "type": "object"
}

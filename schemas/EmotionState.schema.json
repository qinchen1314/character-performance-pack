{
  "$defs": {
    "Appraisal": {
      "additionalProperties": false,
      "properties": {
        "goal_congruence": {
          "default": 0,
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Goal Congruence",
          "type": "number"
        },
        "controllability": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Controllability",
          "type": "number"
        },
        "responsibility": {
          "default": "unknown",
          "enum": [
            "self",
            "target",
            "environment",
            "unknown"
          ],
          "title": "Responsibility",
          "type": "string"
        },
        "certainty": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Certainty",
          "type": "number"
        }
      },
      "title": "Appraisal",
      "type": "object"
    },
    "VAD": {
      "additionalProperties": false,
      "properties": {
        "valence": {
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Valence",
          "type": "number"
        },
        "arousal": {
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Arousal",
          "type": "number"
        },
        "dominance": {
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Dominance",
          "type": "number"
        }
      },
      "required": [
        "valence",
        "arousal",
        "dominance"
      ],
      "title": "VAD",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "primary": {
      "minLength": 1,

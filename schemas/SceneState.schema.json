{
  "$defs": {
    "ActiveAction": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "navigation",
          "default": "navigation",
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "default": "running",
          "enum": [
            "running",
            "paused"
          ],
          "title": "Status",
          "type": "string"
        },
        "goal": {
          "$ref": "#/$defs/BlockingGoal"
        },
        "route": {
          "items": {
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Route",
          "type": "array"
        },
        "edge_index": {
          "default": 0,
          "minimum": 0,
          "title": "Edge Index",
          "type": "integer"
        },
        "elapsed_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "integer"
        },
        "pack_hash": {
          "title": "Pack Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "goal",
        "route",
        "pack_hash"
      ],
      "title": "ActiveAction",
      "type": "object"
    },
    "BlockingGoal": {
      "additionalProperties": false,
      "properties": {
        "destination": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Destination",
          "type": "string"
        },
        "pose": {
          "default": "standing",
          "enum": [
            "standing",
            "seated"
          ],
          "title": "Pose",
          "type": "string"
        },
        "interruption_policy": {
          "default": "pause",
          "enum": [
            "pause",
            "forbid"
          ],
          "title": "Interruption Policy",
          "type": "string"
        }
      },
      "required": [
        "destination"
      ],
      "title": "BlockingGoal",
      "type": "object"
    },
    "EmotionalResidue": {
      "additionalProperties": false,
      "properties": {
        "emotion": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Emotion",
          "type": "string"
        },
        "intensity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Intensity",
          "type": "number"
        },
        "expires_after_turn": {
          "minimum": 0,
          "title": "Expires After Turn",
          "type": "integer"
        }
      },
      "required": [
        "emotion",
        "intensity",
        "expires_after_turn"
      ],
      "title": "EmotionalResidue",
      "type": "object"
    },
    "Landmark": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "label_zh": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Label Zh",
          "type": "string"
        },
        "seat_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seat Id"
        },
        "seat_label": {
          "anyOf": [
            {
              "maxLength": 60,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seat Label"
        },
        "distances": {
          "patternProperties": {
            "^[a-z][a-z0-9_.-]*$": {
              "minimum": 0,
              "type": "number"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Distances",
          "type": "object"
        }
      },
      "required": [
        "id",
        "label_zh"
      ],
      "title": "Landmark",
      "type": "object"
    },
    "PathEdge": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Origin",
          "type": "string"
        },
        "destination": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Destination",
          "type": "string"
        },
        "duration_ms": {
          "exclusiveMinimum": 0,
          "maximum": 3600000,
          "title": "Duration Ms",
          "type": "integer"
        },
        "blocked": {
          "default": false,
          "title": "Blocked",
          "type": "boolean"
        }
      },
      "required": [
        "origin",
        "destination",
        "duration_ms"
      ],
      "title": "PathEdge",
      "type": "object"
    },
    "SceneLayout": {
      "additionalProperties": false,
      "properties": {
        "landmarks": {
          "items": {
            "$ref": "#/$defs/Landmark"
          },
          "title": "Landmarks",
          "type": "array"
        },
        "edges": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PathEdge"
          },
          "title": "Edges",
          "type": "array"
        }
      },
      "required": [
        "landmarks"
      ],
      "title": "SceneLayout",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "scene_id": {
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_.-]*$",
      "title": "Scene Id",
      "type": "string"
    },
    "turn_index": {
      "default": 0,
      "minimum": 0,
      "title": "Turn Index",
      "type": "integer"
    },
    "revision": {
      "default": 0,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "pose": {
      "default": "unknown",
      "enum": [
        "standing",
        "seated",
        "leaning_wall",
        "lying",
        "unknown"
      ],
      "title": "Pose",
      "type": "string"
    },
    "position": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Position"
    },
    "orientation_target": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Orientation Target"
    },
    "held_objects": {
      "additionalProperties": {
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_.-]*$",
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "right_hand",
          "left_hand"
        ]
      },
      "title": "Held Objects",
      "type": "object"
    },
    "distances": {
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*$": {
          "minimum": 0,
          "type": "number"
        }
      },
      "propertyNames": {
        "minLength": 1
      },
      "title": "Distances",
      "type": "object"
    },
    "support_contact": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Support Contact"
    },
    "unfinished_actions": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_.-]*$",
        "type": "string"
      },
      "title": "Unfinished Actions",
      "type": "array"
    },
    "emotional_residue": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EmotionalResidue"
      },
      "title": "Emotional Residue",
      "type": "array"
    },
    "layout": {
      "anyOf": [
        {
          "$ref": "#/$defs/SceneLayout"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "active_action": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActiveAction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "time_ms": {
      "default": 0,
      "minimum": 0,
      "title": "Time Ms",
      "type": "integer"
    }
  },
  "required": [
    "scene_id"
  ],
  "title": "SceneState",
  "type": "object"
}

            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seat Id"
        },
        "seat_label": {
          "anyOf": [
            {
              "maxLength": 60,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seat Label"
        },
        "distances": {
          "patternProperties": {
            "^[a-z][a-z0-9_.-]*$": {
              "minimum": 0,
              "type": "number"
            }
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Distances",
          "type": "object"
        }
      },
      "required": [
        "id",
        "label_zh"
      ],
      "title": "Landmark",
      "type": "object"
    },
    "PathEdge": {
      "additionalProperties": false,

{
  "$defs": {
    "ActiveAction": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "navigation",
          "default": "navigation",
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "default": "running",
          "enum": [
            "running",
            "paused"
          ],
          "title": "Status",
          "type": "string"
        },
        "goal": {
          "$ref": "#/$defs/BlockingGoal"
        },
        "route": {
          "items": {
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_.-]*$",
            "type": "string"
          },
          "title": "Route",
          "type": "array"
        },
        "edge_index": {
          "default": 0,
          "minimum": 0,
          "title": "Edge Index",
          "type": "integer"
        },
        "elapsed_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "integer"
        },
        "pack_hash": {
          "title": "Pack Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "goal",
        "route",
        "pack_hash"
      ],
      "title": "ActiveAction",
      "type": "object"
    },
    "Appraisal": {
      "additionalProperties": false,
      "properties": {
        "goal_congruence": {
          "default": 0,
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Goal Congruence",
          "type": "number"
        },
        "controllability": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Controllability",
          "type": "number"
        },
        "responsibility": {
          "default": "unknown",
          "enum": [
            "self",
            "target",
            "environment",
            "unknown"
          ],
          "title": "Responsibility",
          "type": "string"
        },
        "certainty": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Certainty",
          "type": "number"
        }
      },
      "title": "Appraisal",
      "type": "object"
    },
    "BlockingGoal": {
      "additionalProperties": false,
      "properties": {
        "destination": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Destination",
          "type": "string"
        },
        "pose": {
          "default": "standing",
          "enum": [
            "standing",
            "seated"
          ],
          "title": "Pose",
          "type": "string"
        },
        "interruption_policy": {
          "default": "pause",
          "enum": [
            "pause",
            "forbid"
          ],
          "title": "Interruption Policy",
          "type": "string"
        }
      },
      "required": [
        "destination"
      ],
      "title": "BlockingGoal",
      "type": "object"
    },
    "BlockingStep": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Unit Id",
          "type": "string"
        },
        "phase": {
          "enum": [
            "instant",
            "start",
            "continue",
            "complete",
            "pause",
            "resume"
          ],
          "title": "Phase",
          "type": "string"
        },
        "destination": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Destination"
        },
        "elapsed_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "integer"
        },
        "duration_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "render": {
          "default": true,
          "title": "Render",
          "type": "boolean"
        }
      },
      "required": [
        "unit_id",
        "phase"
      ],
      "title": "BlockingStep",
      "type": "object"
    },
    "EmotionState": {
      "additionalProperties": false,
      "properties": {
        "primary": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",

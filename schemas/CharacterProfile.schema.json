    "SignatureBehaviour": {
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Unit Id",
          "type": "string"
        },
        "affinity": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Affinity",
          "type": "number"
        },
        "cooldown_turns": {
          "default": 9,
          "minimum": 0,
          "title": "Cooldown Turns",
          "type": "integer"
        }
      },
      "required": [
        "unit_id"
      ],
      "title": "SignatureBehaviour",
      "type": "object"
    }

          "type": "string"
        },
        "destination": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Destination",
          "type": "string"
        },
        "duration_ms": {
          "exclusiveMinimum": 0,
          "maximum": 3600000,
          "title": "Duration Ms",
          "type": "integer"
        },
        "blocked": {
          "default": false,
          "title": "Blocked",
          "type": "boolean"
        }
      },
      "required": [
        "origin",
        "destination",
        "duration_ms"
      ],
      "title": "PathEdge",
      "type": "object"

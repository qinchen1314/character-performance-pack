    "Landmark": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "label_zh": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Label Zh",
          "type": "string"
        },
        "seat_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_.-]*$",
              "type": "string"

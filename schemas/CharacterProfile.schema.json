    "Personality": {
      "additionalProperties": false,
      "properties": {
        "big_five": {
          "$ref": "#/$defs/BigFive",
          "default": {
            "openness": 0.5,
            "conscientiousness": 0.5,
            "extraversion": 0.5,
            "agreeableness": 0.5,
            "neuroticism": 0.5
          }
        }

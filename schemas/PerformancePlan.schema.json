          "type": "string"
        },
        "intensity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Intensity",
          "type": "number"
        },
        "expires_after_turn": {
          "minimum": 0,
          "title": "Expires After Turn",
          "type": "integer"
        }
      },
      "required": [
        "emotion",
        "intensity",
        "expires_after_turn"
      ],
      "title": "EmotionalResidue",
      "type": "object"
